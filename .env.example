# UNHEARD configuration. Copy to backend/.env (development) or
# %APPDATA%\Unheard\.env (installed desktop app). Never commit the real file.

# --- Google AI (required for AI features; the map, scores, dossier and
#     simulator work without it) ------------------------------------------
# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: use Vertex AI instead of an API key (production). Requires
# Application Default Credentials (gcloud auth application-default login).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-south1

# Models (verify availability for your key/project)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_S=25
GEMINI_MAX_RETRIES=2

# --- Backend -------------------------------------------------------------
# Port for `python backend/run_backend.py` (the desktop app picks a free port itself)
UNHEARD_PORT=8765
# SQLite store for captured signals + Gemini cache (default: %APPDATA%\Unheard\unheard.db)
# UNHEARD_DB_PATH=
# Comma-separated CORS origins (defaults cover Vite dev + Tauri)
# UNHEARD_CORS_ORIGINS=http://localhost:1420,http://tauri.localhost
# Set automatically by the desktop shell per launch; set manually only for remote deployments
# UNHEARD_API_TOKEN=

# --- Desktop shell -------------------------------------------------------
# Point the desktop app at an existing backend instead of the bundled sidecar
# (e.g. Cloud Run, or `uvicorn` while developing):
# UNHEARD_BACKEND_URL=http://127.0.0.1:8765

# --- Frontend (Vite, browser dev only) -----------------------------------
# VITE_API_BASE=http://127.0.0.1:8765
